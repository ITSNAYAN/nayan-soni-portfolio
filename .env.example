# Copy this file to `.env.local` for local dev, and set the value in your
# hosting dashboard (e.g. Vercel → Project → Settings → Environment Variables)
# for production.

# The canonical URL where this site is served from. Used for
# `metadataBase`, OpenGraph image URLs, and canonical tags.
# Include the scheme, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
